---
// /wrapped — campaign landing page: giveaway entry for one free seat in the
// January Maven cohort ("Fixing the Underperforming Agentic Product"),
// plus an optional "coffee chat" opt-in. Submissions write to
// wrapped_entries (see supabase/migrations/0025_wrapped_giveaway.sql)
// through the public anon key, same pattern as SurveyWidget.astro.
// Entries are listed in Admin → Landing Page.
//
// TODO before sharing this link: confirm the real Maven course title/URL,
// the entry deadline, and how the winner is notified — placeholders below
// are marked clearly.

import BaseLayout from "@layouts/BaseLayout.astro";
import Nav from "@components/Nav.astro";
import Footer from "@components/Footer.astro";

const siteUrl = "https://productimpactpod.com";

// TODO: replace with the real course name + Maven listing URL.
const COURSE_NAME = "Fixing the Underperforming Agentic Product";
const COURSE_URL = "https://maven.com/";
// TODO: replace with the real entry deadline.
const DEADLINE_LABEL = "January 2027 cohort";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: `${COURSE_NAME} — Giveaway | Product Impact`,
  url: `${siteUrl}/wrapped/`,
  isPartOf: { "@id": `${siteUrl}/#website` },
};
---

<BaseLayout
  title={`Win a Spot in Our ${DEADLINE_LABEL} Maven Course | Product Impact`}
  description={`Enter to win one free seat in "${COURSE_NAME}," our Maven course on fixing underperforming agentic products — plus, tell us if you'd like a quick coffee chat.`}
  canonicalUrl={`${siteUrl}/wrapped/`}
  jsonLd={jsonLd}
>
  <Nav />

  <main class="max-w-[720px] mx-auto px-4 md:px-6 py-16">
    {/* Hero */}
    <header class="text-center mb-12">
      <div class="inline-block mb-5 px-4 py-1.5 rounded-full border border-[#ff6b4a]/30 bg-[#ff6b4a]/10 text-[#ff6b4a] text-xs font-bold uppercase tracking-wider">
        Giveaway — {DEADLINE_LABEL}
      </div>
      <h1 class="text-[34px] md:text-[48px] font-extrabold text-white tracking-tight leading-[1.1] mb-5">
        Win a free seat in <span class="text-[#ff6b4a]">{COURSE_NAME}</span>
      </h1>
      <p class="text-[17px] md:text-[19px] text-[#999] leading-relaxed max-w-[560px] mx-auto">
        We're giving away one spot in our Maven course on fixing
        underperforming agentic products. Fill out the form below to enter —
        and if you'd rather just talk it through, check the box and we'll set
        up a quick coffee chat.
      </p>
    </header>

    {/* What you get */}
    <section class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-12">
      {[
        { title: "1 free seat", desc: `Full access to the ${DEADLINE_LABEL} live cohort.` },
        { title: "No cost to enter", desc: "Just fill out the form — no purchase necessary." },
        { title: "Or skip the wait", desc: "Check the coffee chat box below instead." },
      ].map((f) => (
        <div class="p-5 rounded-xl border border-[#1a1a1a] bg-[#0a0a0a] text-center">
          <div class="text-[15px] font-bold text-white mb-1">{f.title}</div>
          <div class="text-[13px] text-[#888] leading-relaxed">{f.desc}</div>
        </div>
      ))}
    </section>

    {/* Form */}
    <section class="rounded-2xl border border-[#1a1a1a] bg-[#0a0a0a] p-6 md:p-8">
      <div id="wrapped-form-root">
        <h2 class="text-xl font-bold text-white mb-1">Enter the giveaway</h2>
        <p class="text-sm text-[#888] mb-6">
          One entry per person. We'll email the winner directly — no spam, ever.
        </p>

        <form id="wrapped-form" class="space-y-4" novalidate>
          <div>
            <label for="wf-first-name" class="block text-xs font-bold uppercase tracking-wide text-[#888] mb-1.5">
              First name
            </label>
            <input
              id="wf-first-name" name="first_name" type="text" required autocomplete="given-name"
              class="w-full px-4 py-3 rounded-lg bg-[#111] border border-[#222] text-white text-[15px] placeholder-[#555] focus:outline-none focus:border-[#ff6b4a]"
              placeholder="Jane"
            />
          </div>

          <div>
            <label for="wf-email" class="block text-xs font-bold uppercase tracking-wide text-[#888] mb-1.5">
              Email
            </label>
            <input
              id="wf-email" name="email" type="email" required autocomplete="email"
              class="w-full px-4 py-3 rounded-lg bg-[#111] border border-[#222] text-white text-[15px] placeholder-[#555] focus:outline-none focus:border-[#ff6b4a]"
              placeholder="jane@company.com"
            />
          </div>

          <div>
            <label for="wf-company" class="block text-xs font-bold uppercase tracking-wide text-[#888] mb-1.5">
              Company
            </label>
            <input
              id="wf-company" name="company" type="text" required autocomplete="organization"
              class="w-full px-4 py-3 rounded-lg bg-[#111] border border-[#222] text-white text-[15px] placeholder-[#555] focus:outline-none focus:border-[#ff6b4a]"
              placeholder="Acme Inc."
            />
          </div>

          <div>
            <label for="wf-city" class="block text-xs font-bold uppercase tracking-wide text-[#888] mb-1.5">
              City
            </label>
            <input
              id="wf-city" name="city" type="text" required autocomplete="address-level2"
              class="w-full px-4 py-3 rounded-lg bg-[#111] border border-[#222] text-white text-[15px] placeholder-[#555] focus:outline-none focus:border-[#ff6b4a]"
              placeholder="San Francisco"
            />
          </div>

          <div>
            <label for="wf-why" class="block text-xs font-bold uppercase tracking-wide text-[#888] mb-1.5">
              Why do you listen to Product Impact?
            </label>
            <textarea
              id="wf-why" name="why_listen" required rows="3"
              class="w-full px-4 py-3 rounded-lg bg-[#111] border border-[#222] text-white text-[15px] placeholder-[#555] focus:outline-none focus:border-[#ff6b4a] resize-vertical"
              placeholder="Tell us in a sentence or two…"
            ></textarea>
          </div>

          <label class="flex items-start gap-3 pt-2 cursor-pointer">
            <input
              id="wf-coffee" name="coffee" type="checkbox"
              class="mt-0.5 w-4 h-4 accent-[#ff6b4a]"
            />
            <span class="text-sm text-[#ccc] leading-relaxed">
              I'd like to participate in a coffee chat with the team.
            </span>
          </label>

          <div id="wf-error" class="hidden text-sm text-[#fca5a5] bg-[#ef4444]/10 rounded-lg px-4 py-3"></div>

          <button
            id="wf-submit" type="submit"
            class="w-full mt-2 px-6 py-3.5 rounded-xl bg-[#ff6b4a] hover:bg-[#ff8566] text-white text-[15px] font-bold transition-colors disabled:opacity-60 disabled:cursor-default"
          >
            Enter the giveaway
          </button>

          <p class="text-xs text-[#555] text-center leading-relaxed pt-1">
            By submitting, you agree to be contacted about this giveaway and
            occasional Product Impact updates. See our{" "}
            <a href="/privacy/" class="text-[#888] hover:text-[#ff6b4a] underline">Privacy Policy</a>.
          </p>
        </form>
      </div>
    </section>

    {/* FAQ */}
    <section class="mt-14">
      <h2 class="text-xl font-bold text-white mb-5">A few details</h2>
      <div class="space-y-4">
        {[
          { q: "How is the winner picked?", a: "We'll review entries after the deadline and pick one winner at random. The winner is notified by email." },
          { q: "What if I don't win?", a: "Check the coffee chat box and we'll reach out directly — no giveaway required." },
          { q: `What is "${COURSE_NAME}"?`, a: `A live Maven cohort on diagnosing and fixing underperforming agentic products. Full syllabus is on the course page.` },
        ].map((item) => (
          <div class="border-b border-[#1a1a1a] pb-4">
            <div class="font-semibold text-white mb-1">{item.q}</div>
            <div class="text-sm text-[#999] leading-relaxed">{item.a}</div>
          </div>
        ))}
      </div>
      <p class="text-sm text-[#666] mt-6">
        Curious about the course itself?{" "}
        <a href={COURSE_URL} target="_blank" rel="noopener" class="text-[#ff6b4a] hover:text-[#ff8566] font-semibold">
          View it on Maven →
        </a>
      </p>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script is:inline define:vars={{ sbUrl: import.meta.env.PUBLIC_SUPABASE_URL, sbKey: import.meta.env.PUBLIC_SUPABASE_ANON_KEY }}>
(function () {
  var form = document.getElementById('wrapped-form');
  if (!form || !sbUrl || !sbKey) return;

  var errorBox = document.getElementById('wf-error');
  var submitBtn = document.getElementById('wf-submit');
  var root = document.getElementById('wrapped-form-root');

  function showError(msg) {
    errorBox.textContent = msg;
    errorBox.classList.remove('hidden');
  }

  function isEmail(s) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(s || '').trim());
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    errorBox.classList.add('hidden');

    var firstName = document.getElementById('wf-first-name').value.trim();
    var email = document.getElementById('wf-email').value.trim();
    var company = document.getElementById('wf-company').value.trim();
    var city = document.getElementById('wf-city').value.trim();
    var whyListen = document.getElementById('wf-why').value.trim();
    var coffee = document.getElementById('wf-coffee').checked;

    if (!firstName) { showError('Please enter your first name.'); return; }
    if (!isEmail(email)) { showError('Please enter a valid email.'); return; }
    if (!company) { showError('Please enter your company.'); return; }
    if (!city) { showError('Please enter your city.'); return; }
    if (!whyListen) { showError('Let us know why you listen.'); return; }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Submitting…';

    fetch(sbUrl + '/rest/v1/wrapped_entries', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': 'Bearer ' + sbKey,
        'apikey': sbKey,
        'Prefer': 'return=minimal',
      },
      body: JSON.stringify({
        first_name: firstName,
        email: email,
        company: company,
        city: city,
        why_listen: whyListen,
        wants_coffee_chat: coffee,
      }),
    }).then(function (r) {
      if (!r.ok) throw new Error('HTTP ' + r.status);
      root.innerHTML =
        '<div class="text-center py-6">' +
        '<div class="text-2xl font-bold text-white mb-2">You\'re entered 🎉</div>' +
        '<p class="text-sm text-[#999] leading-relaxed">We\'ll email the winner directly. ' +
        (coffee ? 'We\'ll also be in touch to set up your coffee chat.' : '') +
        '</p></div>';
    }).catch(function () {
      showError('Could not submit — please try again in a moment.');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Enter the giveaway';
    });
  });
})();
</script>
